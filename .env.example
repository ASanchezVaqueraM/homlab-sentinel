# ==============================================================================
# Homelab Sentinel - Variables de Entorno (Plantilla)
# ==============================================================================
# Copia este archivo como '.env' o expórtalo en tu entorno local antes de iniciar.
# NUNCA subas tu archivo '.env' real con credenciales a un repositorio público.

# Token del bot generado con @BotFather en Telegram (ej. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN="tu_token_aqui"

# ID numérico de tu chat privado o canal obtenido con bots como @userinfobot (ej. 987654321)
TELEGRAM_CHAT_ID="tu_chat_id_aqui"

# Puerto web local para el contenedor de Uptime Kuma
UPTIME_KUMA_PORT=3001
